{
  "name": "privacy-guard-mcp",
  "version": "0.1.0",
  "description": "Local MCP server that detects and redacts sensitive data before it reaches downstream AI tools.",
  "type": "module",
  "main": "dist/server.js",
  "bin": { "privacy-guard-mcp": "dist/server.js" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": { "node": ">=18" },
  "license": "MIT"
}
